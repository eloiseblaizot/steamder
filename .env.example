# Copy to .env.local and fill in.
#
# Only scripts/enrich.ts reads this file (via --env-file=.env.local).
# The site itself runs without any key: it falls back to procedural artwork.

# https://rawg.io/apidocs — free tier, 20k requests/month.
RAWG_API_KEY=

# Public origin. Defaults to https://steamder.com in production,
# http://localhost:3000 in development. Set this for preview deployments.
# STEAMDER_SITE_URL=https://steamder.com

# Where the SQLite file lives. Defaults to ./data/steamder.db
# STEAMDER_DB=/var/lib/steamder/steamder.db
